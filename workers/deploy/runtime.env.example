# 비밀키는 이 파일에 넣지 않는다. 값 확정과 R1-05/06 적용은 계란님·Claude 단계다.
WORKHUB_SUPABASE_URL=https://PROJECT_REF.supabase.co
WORKHUB_EXPECTED_PROJECT_REF=PROJECT_REF
WORKHUB_SCHOOL_ID=학교_UUID_확인_후_입력
WORKHUB_WORKER_ID=검토할_작업자_ID_입력
WORKHUB_WORKER_RELEASE=배포할_커밋_SHA_입력
# Linux 호스트에서 UID 10001 소유·0400. 저장소 밖 경로만 사용한다.
WORKHUB_SECRET_FILE=/etc/workhub/collection-service-key
