# 서버 전용. VITE_ / NEXT_PUBLIC_ 환경값이나 앱 브라우저에 넣지 않는다.
WORKHUB_SUPABASE_URL=https://PROJECT_REF.supabase.co
WORKHUB_EXPECTED_PROJECT_REF=PROJECT_REF
WORKHUB_SERVICE_ROLE_KEY=
# R1-05에서 승인된 실제 학교 ID. 학교 이름이나 학교 코드를 넣지 않는다.
WORKHUB_SCHOOL_ID=
WORKHUB_WORKER_ID=collection-worker-01
WORKHUB_WORKER_RELEASE=r1-connection-1
# 기본은 실제 ClamAV 필요. policy_unscanned는 DB 승인 정책이 허용할 때만 완료 가능.
WORKHUB_SCANNER_MODE=clamav
WORKHUB_CLAMAV_SOCKET=/run/clamav/clamd.ctl

# 컨테이너 파일형 키를 쓸 때는 위 직접 키를 비워 두고 이 경로만 설정한다.
# 이 파일은 변수 이름 안내다. 실제 비밀 파일은 Git 저장소 밖, Linux UID10001·0400으로 보관한다.
# WORKHUB_SERVICE_ROLE_KEY_FILE=/run/secrets/workhub_service_key
