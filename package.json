{
  "name": "daedong-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "대동여중 업무혁신시스템 v2 — npm workspaces 모노레포",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/main",
    "build": "npm run build -w apps/main",
    "preview": "npm run preview -w apps/main",
    "test": "node tests/run.mjs",
    "dev:workhub": "npm run dev -w apps/workhub",
    "build:workhub": "npm run build -w apps/workhub",
    "check:workhub": "npm run check -w apps/workhub",
    "test:workhub:postgres": "node tests/integration/workhub-postgres.mjs",
    "test:workhub:browser": "node tests/browser/run.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "esbuild": "0.25.12",
    "pg": "8.23.1",
    "playwright": "1.62.1"
  }
}
