{
  "version": "1.1",
  "domain": "communication",
  "status": "design_only_no_db_execution",
  "changes": [
    {
      "table": "workhub.messenger_threads",
      "action": "add",
      "columns": [
        {
          "name": "id",
          "type": "text",
          "nullable": false,
          "description": "서버 생성 식별자",
          "immutable": true
        },
        {
          "name": "school_id",
          "type": "text",
          "nullable": false,
          "description": "불변 학교 경계",
          "references": "workhub.schools.id",
          "immutable": true
        },
        {
          "name": "kind",
          "type": "text",
          "nullable": false,
          "description": "direct/group; 생성 후 불변",
          "immutable": true
        },
        {
          "name": "title",
          "type": "text",
          "nullable": true,
          "description": "group 제목; direct는 NULL. 상대 이름은 현재 표시자료로 조립"
        },
        {
          "name": "direct_low_membership_id",
          "type": "text",
          "nullable": true,
          "description": "direct의 정렬상 작은 소속 ID",
          "references": "workhub.memberships.id",
          "immutable": true
        },
        {
          "name": "direct_high_membership_id",
          "type": "text",
          "nullable": true,
          "description": "direct의 정렬상 큰 소속 ID",
          "references": "workhub.memberships.id",
          "immutable": true
        },
        {
          "name": "created_by_membership_id",
          "type": "text",
          "nullable": false,
          "description": "방 생성 당시 소속",
          "references": "workhub.memberships.id",
          "immutable": true
        },
        {
          "name": "created_by_account_id",
          "type": "text",
          "nullable": false,
          "description": "방 생성 당시 계정",
          "references": "workhub.accounts.id",
          "immutable": true
        },
        {
          "name": "state",
          "type": "text",
          "nullable": false,
          "description": "active/archived; 보관은 삭제/권한회수가 아님"
        },
        {
          "name": "participant_epoch",
          "type": "bigint",
          "nullable": false,
          "description": "참여/탈퇴/역할변경마다 증가; 발송 확인 지문에 포함"
        },
        {
          "name": "last_seq",
          "type": "bigint",
          "nullable": false,
          "description": "0부터 시작. 이 방 마지막 커밋 메시지 순번; 순번 배정은 방 잠금 아래 실행"
        },
        {
          "name": "version",
          "type": "integer",
          "nullable": false,
          "description": "1부터 시작하는 낙관적 동시성 판"
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "nullable": false,
          "description": "서버 생성 시각"
        },
        {
          "name": "updated_at",
          "type": "timestamptz",
          "nullable": false,
          "description": "서버 최신 활동 시각"
        }
      ],
      "constraints": [
        "PRIMARY KEY(id)",
        "UNIQUE(school_id,id)",
        "school_id와 모든 작성 주체/부모 관계는 불변; FK 삭제는 RESTRICT/NO ACTION, 학교/계정 CASCADE 금지",
        "kind=direct iff 두 direct membership 존재 AND low<high; group이면 두 열 모두 NULL",
        "UNIQUE(school_id,direct_low_membership_id,direct_high_membership_id) WHERE kind=direct",
        "(school_id,direct_low_membership_id)/(school_id,direct_high_membership_id) FK memberships(school_id,id); 서로 다른 현재 소속, 계정도 서로 달라야 함",
        "(school_id,created_by_membership_id,created_by_account_id) FK memberships(school_id,id,account_id)",
        "last_seq>=0, participant_epoch>=1, version>=1; direct 방은 정확히 두 지정 소속만 참여 가능",
        "group title은 공백제거 후 비어있지 않음; 직접 DM에는 title 없음. 길이 한도는 승인된 입력 규격에서 조회"
      ],
      "indexes": [
        "(school_id,updated_at DESC,id)",
        "(school_id,state,id)"
      ],
      "rules": [
        "같은 학교 두 소속의 역순 동시 DM 생성은 UNIQUE와 멱등 명령으로 한 방으로 수렴한다.",
        "전출 뒤 새 소속으로 돌아온 사용자는 새 membership이므로 옛 DM이 자동 재개되지 않는다.",
        "group에서 현재 manager가 0명이 되는 변경은 현재 참여자에게 역할 인계하거나 방 archived 처리와 원자 결합한다. 학교 관리자 자동 manager 승격 금지.",
        "나가기/멤버 추가/재입장은 participant_epoch 증가. 재입장은 새 참여 행과 새 visible_from_seq를 만든다."
      ],
      "read_policy": "현재 학교 소속이 활성이고 현재 참여 episode가 active인 사람만. 퇴직·탈퇴 시 목록/검색/본문/파일 즉시 차단. 관리자·플랫폼 자동 열람 불가.",
      "tests": [
        "MSG01",
        "MSG02",
        "MSG03",
        "MSG04"
      ]
    },
    {
      "table": "workhub.messenger_participants",
      "action": "add",
      "columns": [
        {
          "name": "id",
          "type": "text",
          "nullable": false,
          "description": "서버 생성 식별자",
          "immutable": true
        },
        {
          "name": "school_id",
          "type": "text",
          "nullable": false,
          "description": "불변 학교 경계",
          "references": "workhub.schools.id",
          "immutable": true
        },
        {
          "name": "thread_id",
          "type": "text",
          "nullable": false,
          "description": "대화방",
          "references": "workhub.messenger_threads.id",
          "immutable": true
        },
        {
          "name": "membership_id",
          "type": "text",
          "nullable": false,
          "description": "참여 당시 고정 소속",
          "references": "workhub.memberships.id",
          "immutable": true
        },
        {
          "name": "account_id",
          "type": "text",
          "nullable": false,
          "description": "참여자 계정",
          "references": "workhub.accounts.id",
          "immutable": true
        },
        {
          "name": "role",
          "type": "text",
          "nullable": false,
          "description": "manager/member; direct는 member"
        },
        {
          "name": "state",
          "type": "text",
          "nullable": false,
          "description": "active/left/removed; 종료 후 같은 행을 active로 되돌리지 않음"
        },
        {
          "name": "visible_from_seq",
          "type": "bigint",
          "nullable": false,
          "description": "참여 직후 볼 수 있는 첫 순번; 기본 last_seq+1",
          "immutable": true
        },
        {
          "name": "last_read_seq",
          "type": "bigint",
          "nullable": false,
          "description": "실제 화면에 표시한 연속 읽음 경계; visible_from_seq-1 이상, 단조 증가"
        },
        {
          "name": "joined_at",
          "type": "timestamptz",
          "nullable": false,
          "description": "참여 시작"
        },
        {
          "name": "ended_at",
          "type": "timestamptz",
          "nullable": true,
          "description": "left/removed이면 필수"
        },
        {
          "name": "ended_by_membership_id",
          "type": "text",
          "nullable": true,
          "description": "자발적 나가기/제거 수행자; 소속 종료 worker는 NULL",
          "references": "workhub.memberships.id"
        },
        {
          "name": "version",
          "type": "integer",
          "nullable": false,
          "description": "1부터 시작하는 낙관적 동시성 판"
        }
      ],
      "constraints": [
        "PRIMARY KEY(id)",
        "UNIQUE(school_id,id)",
        "school_id와 모든 작성 주체/부모 관계는 불변; FK 삭제는 RESTRICT/NO ACTION, 학교/계정 CASCADE 금지",
        "UNIQUE(school_id,thread_id,id)",
        "(school_id,thread_id) FK messenger_threads(school_id,id)",
        "(school_id,membership_id,account_id) FK memberships(school_id,id,account_id)",
        "(school_id,ended_by_membership_id) FK memberships(school_id,id)",
        "UNIQUE(thread_id,membership_id) WHERE state=active",
        "state=active iff ended_at IS NULL; visible_from_seq>=1; last_read_seq>=visible_from_seq-1",
        "동일 thread/membership episode 기간은 중첩 금지. 종료 시점은 joined_at 이상; 새 episode는 ended_at 뒤 생성",
        "joined_at/visible_from_seq와 thread/member/account 정체성 불변; ended 상태에서 active로 역전 금지",
        "UNIQUE(school_id,thread_id,id,membership_id,account_id)"
      ],
      "indexes": [
        "(school_id,membership_id,thread_id) WHERE state=active",
        "(school_id,thread_id,state,id)"
      ],
      "rules": [
        "읽음 명령은 해당 episode의 접근 가능 메시지 순번만 허용하고 max(기존,입력)로 갱신한다.",
        "페이지가 뒤에서 열리면 현재 화면 이전을 읽음으로 처리할지 UI에서 명시해 자동 과장하지 않는다. 미조회 앞부분이 있으면 연속 경계 이전까지만 갱신한다.",
        "새 참여자/재입장자는 새 visible_from_seq 이후만 본다. 과거 파일/검색/인용/AI 문맥도 같은 경계 적용.",
        "메시지를 읽어도 수합 제출/시간표 동의/공지 확인 상태는 바뀌지 않는다."
      ],
      "read_policy": "본인 episode와 현재 방의 최소 참여자 정보만. 다른 학교/관계없는 관리자 불가. 종료 참여자도 기존 메시지 발신 표시용 최소 탈퇴 표식만 반환.",
      "tests": [
        "MSG02",
        "MSG03",
        "MSG05",
        "MSG14"
      ]
    },
    {
      "table": "workhub.messenger_dispatches",
      "action": "add",
      "columns": [
        {
          "name": "id",
          "type": "text",
          "nullable": false,
          "description": "서버 생성 식별자",
          "immutable": true
        },
        {
          "name": "school_id",
          "type": "text",
          "nullable": false,
          "description": "불변 학교 경계",
          "references": "workhub.schools.id",
          "immutable": true
        },
        {
          "name": "sender_membership_id",
          "type": "text",
          "nullable": false,
          "description": "발송 주체의 고정 소속",
          "references": "workhub.memberships.id",
          "immutable": true
        },
        {
          "name": "sender_account_id",
          "type": "text",
          "nullable": false,
          "description": "인증에서 파생한 발송 계정",
          "references": "workhub.accounts.id",
          "immutable": true
        },
        {
          "name": "mode",
          "type": "text",
          "nullable": false,
          "description": "direct/group/broadcast_direct; 수신자에게 서로 다른 의미",
          "immutable": true
        },
        {
          "name": "group_thread_id",
          "type": "text",
          "nullable": true,
          "description": "group일 때만 대상 방",
          "references": "workhub.messenger_threads.id",
          "immutable": true
        },
        {
          "name": "expected_participant_epoch",
          "type": "bigint",
          "nullable": true,
          "description": "group 확인 당시 참여판"
        },
        {
          "name": "body",
          "type": "text",
          "nullable": false,
          "description": "정규화한 plain text 본문; 승인된 렌더러만 사용, HTML 실행 없음",
          "immutable": true
        },
        {
          "name": "content_sha256",
          "type": "text",
          "nullable": false,
          "description": "본문·파일지문·업무카드·전달모드의 canonical SHA-256",
          "immutable": true
        },
        {
          "name": "confirmation_sha256",
          "type": "text",
          "nullable": false,
          "description": "content + 정확한 정렬 수신자 + 현재권한판 + 방참여판 + 정책판 + 만료의 지문",
          "immutable": true
        },
        {
          "name": "recipient_selector",
          "type": "jsonb",
          "nullable": false,
          "description": "직접 ID/부서/학년 등 명단 생성 조건. 실제 발송 대상은 targets 고정 집합",
          "immutable": true
        },
        {
          "name": "policy_bindings",
          "type": "jsonb",
          "nullable": false,
          "description": "적용 정책의 scope_key/id/version 및 명령 registry 판; 임의 실행문 불가",
          "immutable": true
        },
        {
          "name": "permission_context",
          "type": "jsonb",
          "nullable": false,
          "description": "확인 당시 계정/학교/소속/역할 권한판. 실행 때 현재값과 비교",
          "immutable": true
        },
        {
          "name": "origin",
          "type": "text",
          "nullable": false,
          "description": "manual/ai/workflow; AI도 교사가 발신자",
          "immutable": true
        },
        {
          "name": "tool_proposal_id",
          "type": "text",
          "nullable": true,
          "description": "AI 확인 제안과의 1방향 연결; payload가 이 dispatch와 지문 참조",
          "references": "workhub.tool_proposals.id",
          "immutable": true
        },
        {
          "name": "card_kind",
          "type": "text",
          "nullable": true,
          "description": "collection/timetable_change; 없으면 다른 card 열도 NULL",
          "immutable": true
        },
        {
          "name": "collection_id",
          "type": "text",
          "nullable": true,
          "description": "수합 안내 카드의 현재 원본",
          "references": "workhub.collections.id",
          "immutable": true
        },
        {
          "name": "timetable_change_set_id",
          "type": "text",
          "nullable": true,
          "description": "시간표 변경 카드의 현재 원본",
          "references": "workhub.timetable_change_sets.id",
          "immutable": true
        },
        {
          "name": "card_version",
          "type": "integer",
          "nullable": true,
          "description": "표시 제안 당시 원본 판; 행동 시 현재 원본 재검사",
          "immutable": true
        },
        {
          "name": "state",
          "type": "text",
          "nullable": false,
          "description": "prepared/confirmed/sending/completed/partial/failed/cancelled/expired"
        },
        {
          "name": "expires_at",
          "type": "timestamptz",
          "nullable": false,
          "description": "확인 유효 시각; 구체 유효시간은 승인 정책"
        },
        {
          "name": "confirmed_at",
          "type": "timestamptz",
          "nullable": true,
          "description": "교사가 정확한 지문을 확인한 서버 시각"
        },
        {
          "name": "confirmed_by_membership_id",
          "type": "text",
          "nullable": true,
          "description": "sender_membership_id와 같아야 함",
          "references": "workhub.memberships.id"
        },
        {
          "name": "target_count",
          "type": "integer",
          "nullable": false,
          "description": "준비 시 고정 대상 수. 최소 1"
        },
        {
          "name": "version",
          "type": "integer",
          "nullable": false,
          "description": "1부터 시작하는 낙관적 동시성 판"
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "nullable": false,
          "description": "생성 시각"
        },
        {
          "name": "completed_at",
          "type": "timestamptz",
          "nullable": true,
          "description": "모든 대상 최종결과가 있을 때"
        }
      ],
      "constraints": [
        "PRIMARY KEY(id)",
        "UNIQUE(school_id,id)",
        "school_id와 모든 작성 주체/부모 관계는 불변; FK 삭제는 RESTRICT/NO ACTION, 학교/계정 CASCADE 금지",
        "(school_id,sender_membership_id,sender_account_id) FK memberships(school_id,id,account_id)",
        "(school_id,group_thread_id) FK messenger_threads(school_id,id)",
        "(school_id,collection_id) FK collections(school_id,id); (school_id,timetable_change_set_id) FK timetable_change_sets(school_id,id)",
        "card_kind=collection이면 collection_id/card_version만 존재; timetable_change이면 timetable_change_set_id/card_version만 존재; 없음이면 전부 NULL",
        "UNIQUE(school_id,id,sender_membership_id,sender_account_id)",
        "group mode iff group_thread_id와 expected_participant_epoch 존재; direct는 target_count=1",
        "tool_proposal_id는 동일 school·actor·origin membership의 tool_proposals이며 cmd_messenger_confirm 전용 tool registry; 일반 FK 외 명령 검증",
        "confirmed_at/confirmed_by는 둘 다 NULL 또는 존재하고 confirmed_by=sender; confirmed 이후 상태에는 확인 필수",
        "confirmed/completed 후 content/selector/정확한 대상/첨부/card/확인 맥락 불변; 수정은 새 dispatch",
        "준비안은 trim(body) 비어있지 않음 OR 첨부 존재 OR 업무카드 존재; 실제 대상행 수=target_count, 학교/소속별 중복 없음",
        "prepared 생성과 targets/files를 같은 transaction으로 생성하고 지연 무결성 검사. 정규화 본문/card/policy JSON은 서버 schema로 검증"
      ],
      "indexes": [
        "(school_id,sender_membership_id,created_at DESC,id)",
        "(school_id,state,created_at,id) WHERE state IN(prepared,confirmed,sending,partial)",
        "(school_id,tool_proposal_id) WHERE tool_proposal_id IS NOT NULL"
      ],
      "rules": [
        "본문은 이 불변 dispatch에 한 번만 보관하고 messenger_messages가 참조한다. 일반 수신자는 dispatch 직접 조회 불가, 메시지 DTO에서 본문만 받는다.",
        "AI prepared만으로 전송하지 않는다. 확인 이후 target 고정. 명단 변화는 확인 전 STALE, 확인 후 새로운 교사를 자동 추가하지 않음.",
        "confirmed 이후 권한 상실·소속 종료는 미전송 대상 blocked. 이미 전달된 사실은 지우지 않고 현재 메시지 열람권을 별도로 적용한다.",
        "정정은 dispatch_targets.corrects_message_id가 가리키는 과거 본문을 덮어쓰지 않는 새 메시지. 원메시지 조회 시 정정 연결을 표시; 학교 일반관리자가 타인 메시지를 정정할 수 없음.",
