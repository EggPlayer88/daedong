{
  "_comment": "manifest v2 DRAFT (2026-08-17). 실측한 「교수·학습 및 평가 계획서」 양식 기준의 필드 '키 구조' 확정본. ⚠ token 값은 전부 TBD — 내일 양식 v2(수행 4열 + 출제계획 4블록) 수령 후 Claude Web 이 토큰을 심으면서 확정한다. 코드(chat 프롬프트 생성, PLAN_READY 파싱, UI 확인 카드)는 이 키 구조를 기준으로 오늘 작성 가능.",
  "manifest_version": 2,
  "doc_type": "evaluation_plan",
  "doc_title": "교수·학습 및 평가 계획서",
  "template_file": "template.hwpx",
  "filename_pattern": "{year}학년도_{semester}학기_{subject}_{grade}학년_평가계획서(초안).hwpx",

  "basic_fields": [
    { "key": "year",         "label": "학년도", "type": "number", "required": true, "default": 2026 },
    { "key": "semester",     "label": "학기",   "type": "number", "required": true, "default": 2 },
    { "key": "grade",        "label": "대상 학년", "type": "number", "required": true },
    { "key": "subject",      "label": "교과(과목명)", "type": "text", "required": true },
    { "key": "teacher_name", "label": "작성 교사", "type": "text", "required": true },
    { "key": "weekly_hours", "label": "주당 시수", "type": "number", "required": true }
  ],

  "monthly_plan": {
    "_comment": "교수·학습 계획 표. 5행 고정 (8~12월). hours_cum 은 '9/9' 형식 문자열.",
    "rows": 5,
    "months": ["8월", "9월", "10월", "11월", "12월"],
    "row_fields": [
      { "key": "hours_cum",     "label": "시수/누계" },
      { "key": "units",         "label": "단원명(교수·학습 내용)" },
      { "key": "standards",     "label": "성취기준" },
      { "key": "eval_elements", "label": "평가 요소" }
    ]
  },

  "min_achievement_plan": { "key": "min_achievement_plan", "label": "최소 성취수준 미도달 예상 학생 지도 방안", "type": "text", "required": false },

  "eval_purpose": { "key": "eval_purpose", "label": "평가 목적", "type": "list", "count": 3 },

  "exam": {
    "_comment": "정기시험. count 0/1/2. count 에 따라 서버가 고정 문구 2곳(1회고사와 2회고사 문장, 반영비율 문장)을 조립한다 — 조립 규칙은 generate 쪽 composition_rules 로 확정 예정.",
    "key": "exam",
    "fields": [
      { "key": "count",      "label": "정기시험 횟수", "type": "number", "enum": [0, 1, 2], "required": true },
      { "key": "ratio",      "label": "정기시험 반영비율(%)", "type": "number" },
      { "key": "mc_points",  "label": "회차별 선택형 배점(100점 만점 중)", "type": "number" },
      { "key": "essay_points", "label": "회차별 서술형 배점", "type": "number" }
    ],
    "rounds": {
      "max": 2,
      "item_fields": [
        { "key": "label",     "label": "회차명 (1차/2차)" },
        { "key": "period",    "label": "평가 시기" },
        { "key": "standards", "label": "출제 범위 성취기준" },
        { "key": "mc",        "label": "선택형 만점(반영비율)" },
        { "key": "essay",     "label": "서·논술형 만점(반영비율)" }
      ]
    }
  },

  "perf_summary": {
    "_comment": "평가 세부 운영 계획 표의 수행평가 열 (최대 4). 미사용 열은 빈칸 유지.",
    "key": "perf_areas",
    "min": 1,
    "max": 4,
    "strategy": "fixed_columns_blank_unused",
    "item_fields": [
      { "key": "name",        "label": "영역(수행평가명)" },
      { "key": "points",      "label": "영역 만점(반영비율)" },
      { "key": "essay_ratio", "label": "서·논술형 반영비율(해당 시)" },
      { "key": "standards",   "label": "교육과정 성취기준" },
      { "key": "period",      "label": "평가 시기" }
    ]
  },

  "essay_total_ratio": { "key": "essay_total_ratio", "label": "서·논술형 전체 반영비율 합계(%)", "type": "number", "validation": "예외 교과가 아니면 30 이상" },

  "achievement_levels": {
    "key": "achievement_levels",
    "label": "학기 단위 성취수준 진술",
    "levels": ["A", "B", "C", "D", "E"],
    "required": false
  },

  "perf_plans": {
    "_comment": "8. 수행평가 출제 계획 블록 (수행평가 개수만큼, 최대 4). 미사용 블록은 서버가 통째 삭제. elements 는 평가 요소/수행수준(채점기준)/배점 행 — 양식 v2 의 행 수 실측 후 max_rows 확정.",
    "key": "perf_plans",
    "max": 4,
    "strategy": "fixed_blocks_delete_unused",
    "item_fields": [
      { "key": "name",          "label": "수행평가명" },
      { "key": "task",          "label": "수행 과제" },
      { "key": "standards",     "label": "교육과정 성취기준" },
      { "key": "criteria_high", "label": "평가기준 (상)" },
      { "key": "criteria_mid",  "label": "평가기준 (중)" },
      { "key": "criteria_low",  "label": "평가기준 (하)" },
      { "key": "methods",       "label": "평가방법 체크", "type": "multi_select",
        "options": ["서술·논술", "구술·발표", "토의·토론", "프로젝트", "실험·실습", "포트폴리오", "기타", "교사 관찰 및 기록", "자기평가", "동료평가"] },
      { "key": "elements",      "label": "평가 요소별 수행수준·배점", "type": "table_rows",
        "row_fields": ["element", "level_desc", "points"], "max_rows": "TBD(양식 v2 실측)" },
      { "key": "absentee_rule", "label": "결시자·학적변동자 처리", "required": false }
    ]
  },

  "pending": [
    "token 전체 — 양식 v2 수령 후 확정",
    "exam.count 별 고정 문구 조립 규칙(composition_rules) — 템플릿 토큰화와 함께 확정",
    "perf_count_rule: 시험 1회 시 수행 상한 — 계란님 답 대기",
    "essay_ratio_rule.exempt_subjects — 예외 교과 목록 대기",
    "perf_plans.elements.max_rows — 양식 v2 실측 대기"
  ]
}
